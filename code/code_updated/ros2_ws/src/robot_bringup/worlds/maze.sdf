<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="maze_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ánh sáng môi trường -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Mặt sàn 20m x 20m -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- BẢN ĐỒ CẤP ĐỘ 1: MÊ CUNG THU HẸP ĐẬM ĐẶC (COMPACT MAZE)-->
    <!-- Kích thước: 6m x 6m, Toạ độ: X [-3, 3], Y [-3, 3]       -->
    <!-- Đặc điểm: Nhiều khúc cua 90 độ, ngã 3, ngã 4, hẻm hẹp   -->
    <!-- Vị trí spawn (0,0) hoàn toàn trống bán kính 1.1m       -->
    <!-- ======================================================= -->

    <!-- Tường ngoài Bắc (Y = +3.0) -->
    <model name="outer_north">
      <static>true</static>
      <pose>0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.2 1.0</size></box></geometry>
        <material><diffuse>0.3 0.35 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Tường ngoài Nam (Y = -3.0) -->
    <model name="outer_south">
      <static>true</static>
      <pose>0 -3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.2 1.0</size></box></geometry>
        <material><diffuse>0.3 0.35 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Tường ngoài Tây (X = -3.0) -->
    <model name="outer_west">
      <static>true</static>
      <pose>-3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 6.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.0 1.0</size></box></geometry>
        <material><diffuse>0.3 0.35 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Tường ngoài Đông (X = +3.0) -->
    <model name="outer_east">
      <static>true</static>
      <pose>3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 6.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.0 1.0</size></box></geometry>
        <material><diffuse>0.3 0.35 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- CẤU TRÚC VÁCH NGĂN MÊ CUNG BÊN TRONG                    -->
    <!-- ======================================================= -->

    <!-- Vách chia nhánh Bắc-Nam trục giữa (chừa khoảng hở ở tâm và đỉnh/đáy) -->
    <model name="divider_north">
      <static>true</static>
      <pose>0.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.6 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.6 1.0</size></box></geometry>
        <material><diffuse>0.7 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="divider_south">
      <static>true</static>
      <pose>0.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.6 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.6 1.0</size></box></geometry>
        <material><diffuse>0.7 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PHÂN VÙNG TÂY BẮC (X < 0, Y > 0) -->
    <model name="wall_nw_horiz">
      <static>true</static>
      <pose>-1.6 1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.15 1.0</size></box></geometry>
        <material><diffuse>0.2 0.6 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_nw_vert">
      <static>true</static>
      <pose>-1.5 0.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.2 1.0</size></box></geometry>
        <material><diffuse>0.2 0.6 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PHÂN VÙNG ĐÔNG BẮC (X > 0, Y > 0) -->
    <model name="wall_ne_vert">
      <static>true</static>
      <pose>1.5 1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.6 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.6 1.0</size></box></geometry>
        <material><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_ne_horiz">
      <static>true</static>
      <pose>2.1 0.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.15 1.0</size></box></geometry>
        <material><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PHÂN VÙNG TÂY NAM (X < 0, Y < 0) -->
    <model name="wall_sw_horiz">
      <static>true</static>
      <pose>-1.4 -1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.15 1.0</size></box></geometry>
        <material><diffuse>0.8 0.5 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_sw_vert">
      <static>true</static>
      <pose>-2.1 -0.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.4 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.4 1.0</size></box></geometry>
        <material><diffuse>0.8 0.5 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PHÂN VÙNG ĐÔNG NAM (X > 0, Y < 0) -->
    <model name="wall_se_horiz">
      <static>true</static>
      <pose>1.4 -1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 0.15 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.15 1.0</size></box></geometry>
        <material><diffuse>0.6 0.2 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_se_vert">
      <static>true</static>
      <pose>1.5 -2.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.4 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.4 1.0</size></box></geometry>
        <material><diffuse>0.6 0.2 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- CHƯỚNG NGẠI VẬT TẠO NGÕ RẼ BẮT BUỘC -->
    <model name="obs_box_nw">
      <static>true</static>
      <pose>-0.8 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 0.35 0.5</size></box></geometry>
        <material><diffuse>0.3 0.7 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obs_cyl_ne">
      <static>true</static>
      <pose>2.3 2.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
        <material><diffuse>0.9 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obs_box_sw">
      <static>true</static>
      <pose>-2.2 -2.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 0.35 0.5</size></box></geometry>
        <material><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obs_cyl_se">
      <static>true</static>
      <pose>2.3 -2.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
        <material><diffuse>0.7 0.2 0.8 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
